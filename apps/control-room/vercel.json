{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && cp public/state*.json dist/",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/state(.*).json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
