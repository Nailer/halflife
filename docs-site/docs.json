{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Halflife",
  "description": "A use-by date for cryptographic security. Signed, expiring security passports for zero-knowledge circuits, enforced on Solana and propagated over Hyperlane.",
  "colors": {
    "primary": "#D29922",
    "light": "#E3B341",
    "dark": "#9A6700"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://halflife-control-room.vercel.app"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "grid"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/Nailer/halflife"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open the control room",
      "href": "https://halflife-control-room.vercel.app"
    }
  },
  "contextual": {
